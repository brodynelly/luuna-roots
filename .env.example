# luuna-roots — environment variables
#
# The CLI reads these from its process environment; it never loads a .env file
# itself. Copy this file for shell tooling only; .env is gitignored.

# Preferred human actor name (`human:<name>` is also accepted). Falls back to
# `git config user.name`. If defined, even blank, this masks ROOTS_USER.
LUUNA_ROOTS_USER=

# Compatibility alias for existing upstream/harness tooling.
ROOTS_USER=

# Preferred agent actor (`agent:<model>`). --as wins. If defined, even blank,
# this masks ROOTS_AGENT for agent-facing commands.
LUUNA_ROOTS_AGENT=

# Compatibility alias. Legacy ROOTS_AGENT also continues to trigger the
# historic human-command refusal behavior where applicable.
ROOTS_AGENT=

# Legacy compatibility name reserved for upstream/harness tooling. Roots does
# not require it for normal operation.
ROOTS_DEBUG=

# Editors used by plant, think, and adopt (VISUAL wins over EDITOR).
EDITOR=
VISUAL=

# Disable ANSI color (FORCE_COLOR=1 forces it).
NO_COLOR=

# Set only by Roots while it invokes agent.command; do not set by hand.
# ROOTS_SESSION and ROOTS_NODE identify a think session; ROOTS_FLOW identifies
# a Flow session. Roots also sets ROOTS_AGENT and LUUNA_ROOTS_AGENT for that process.
# ROOTS_SESSION=
# ROOTS_NODE=
# ROOTS_FLOW=

# Test-only; honored only when NODE_ENV=test, never for an agent command.
# ROOTS_FORCE_TTY=1
