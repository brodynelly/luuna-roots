{
	"name": "@luuna/roots-cli",
	"version": "0.0.0",
	"description": "Git-native intent for projects: humans write ideas, agents ask and propose",
	"type": "module",
	"bin": {
		"luuna-roots": "./src/index.ts",
		"lrt": "./src/index.ts"
	},
	"main": "src/index.ts",
	"files": [
		"src"
	],
	"private": true,
	"engines": {
		"bun": ">=1.0.0"
	},
	"author": "Brodynelly",
	"contributors": ["Jaymin West (original Roots author)"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/brodynelly/luuna-roots.git"
	},
	"scripts": {
		"test": "bun test",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write --error-on-warnings .",
		"typecheck": "tsc --noEmit",
		"check:agents": "bun run scripts/validate-agents-md.ts --known-missing idea.md --known-missing .luuna/atlas/archive --known-missing .luuna/roots --known-missing .luuna/roots/human",
		"check:dups": "bunx jscpd",
		"check:deps": "knip --dependencies",
		"check:size": "bun run scripts/check-file-sizes.ts --budget scripts/file-size-budgets.json",
		"check:debt": "bun run scripts/check-debt-markers.ts --budget scripts/debt-markers-budget.json",
		"check:coverage": "bun run scripts/check-coverage.ts --budget scripts/coverage-budgets.json",
		"check:ci-parity": "bun scripts/check-ci-parity.ts",
		"check:all": "bun scripts/check-all.ts",
		"verify": "bun run check:all",
		"test:ci": "mkdir -p test-results && bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage --reporter=junit --reporter-outfile=test-results/junit.xml",
		"report:test-timing": "bun run scripts/report-test-timing.ts",
		"report:quality": "bun run scripts/report-quality-metrics.ts",
		"prepare": "[ -e .git ] && git config core.hooksPath scripts/hooks || true"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@types/bun": "latest",
		"knip": "^6",
		"typescript": "^5.9.0",
		"yaml": "^2.9.0"
	}
}
